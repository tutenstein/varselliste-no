# Non-secret configuration for Cloud Functions (committed).
# There are no secrets yet: every source in the MVP is open and keyless.

# MET Norway (api.met.no) requires a User-Agent with the app name and a contact address,
# and may block clients without one. TODO: replace the placeholder before going live.
INGEST_USER_AGENT="Varsellisten/0.1 (+https://varselliste-no.web.app; kontakt: TODO)"

# How many days back the initial backfill fetches (Politiloggen, one day per run).
BACKFILL_DAYS=30
